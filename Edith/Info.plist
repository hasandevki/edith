<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>tr</string>
	<key>CFBundleDisplayName</key>
	<string>J.A.R.V.I.S</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Edith</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Meta AI geri çağırma URL şeması -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>edith</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>

	<!-- Meta Wearables Device Access Toolkit -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>edith://</string>
		<!-- Developer Mode açıkken 0 yeterli. Yayın için Wearables Developer Center'dan alınır. -->
		<key>MetaAppID</key>
		<string>0</string>
		<key>ClientToken</key>
		<string></string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>

	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>location</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Edith nerede olduğunu bilsin: yakındaki yerler, yol tarifi, hava durumu.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Edith takvimine etkinlik ekleyip programını okuyabilsin.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Edith senin için hatırlatıcı oluşturabilsin.</string>

	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Ray-Ban Meta gözlüğüne bağlanmak için gerekli.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Ray-Ban Meta gözlüğüne bağlanmak için gerekli.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Gözlükle Wi-Fi üzerinden daha kaliteli görüntü aktarımı için.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Edith seni duyabilmek için mikrofona ihtiyaç duyar.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Söylediklerini yazıya çevirip Edith'e iletmek için.</string>
	<key>NSCameraUsageDescription</key>
	<string>Gözlük olmadan test için telefon kamerası kullanılabilir.</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
